{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "twiceagency-portfolio",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*"]
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "447762053945-i2g9u767cq4m6bod38ookgc3ac887q7h.apps.googleusercontent.com",
    "GITHUB_REPO": "Ivantwice99/portfolioTwiceAgency",
    "GITHUB_BRANCH": "main"
  }
}
